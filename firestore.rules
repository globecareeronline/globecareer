rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'ahmadbusiness.pk@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isOwner(userId) && incoming().uid == userId;
      allow delete: if isOwner(userId) || isAdmin();

      // User Subscription (Managed exclusively by backend / admin or initialized as free)
      match /subscription/{subId} {
        allow get: if isOwner(userId) || isAdmin();
        allow list: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && incoming().status == 'free';
        allow update, delete: if isAdmin();
      }

      // Cloud Resumes
      match /resumes/{resumeId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId) || isAdmin();
      }

      // Job Application Pipeline
      match /applications/{appId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) && incoming().userId == userId;
        allow delete: if isOwner(userId) || isAdmin();
      }
    }

    // Public / Verified International Jobs
    match /jobs/{jobId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // User Job Reports & Flagging
    match /job_reports/{reportId} {
      allow create: if incoming().reason in ['scam_money', 'broken_link', 'expired', 'misleading', 'other'] && incoming().status == 'pending';
      allow get, list, update, delete: if isAdmin();
    }

    // Admin Directory
    match /admins/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
  }
}
