{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "GlobeCareer",
  "url": "https://globecareer.com",
  "description": "Free international career platform offering country-tailored CV builders, cover letters, resignation letters, professional bios, and 40-country hiring standards.",
  "pricing": {
    "model": "100% Free",
    "subscription": false,
    "watermarks": false
  },
  "tools": [
    {
      "name": "Resume Builder",
      "route": "/resume-builder",
      "exports": ["PDF", "DOCX", "JSON"],
      "features": ["40-country standards", "ATS scoring", "vector print"]
    },
    {
      "name": "Professional Bio Generator",
      "route": "/bio-generator",
      "templatesRoute": "/bio-templates",
      "templateCount": 15,
      "modes": ["short", "medium", "extended", "first-person", "third-person"]
    },
    {
      "name": "Resume Summary & Objective Generator",
      "route": "/summary-generator",
      "templatesRoute": "/summary-templates",
      "templateCount": 18,
      "modes": ["summary", "objective", "headline"],
      "builderIntegration": true
    },
    {
      "name": "Resignation Letter Generator",
      "route": "/resignation-letter",
      "templatesRoute": "/resignation-letter-templates",
      "templateCount": 11,
      "exports": ["TXT", "Print"],
      "jurisdictions": ["US", "UK", "Germany", "Australia"]
    },
    {
      "name": "Cover Letter Builder",
      "route": "/cover-letter-builder",
      "templatesRoute": "/letter-templates"
    },
    {
      "name": "ATS Resume Checker",
      "route": "/ats-checker",
      "features": ["JD keyword comparison", "missing skills analysis"]
    },
    {
      "name": "Job Application Tracker",
      "route": "/job-tracker",
      "type": "Kanban pipeline"
    },
    {
      "name": "Country CV Guides",
      "route": "/country-guides",
      "totalCountries": 40
    }
  ]
}
